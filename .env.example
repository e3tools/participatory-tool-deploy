# Common Passwords
DB_ROOT_PASSWORD=strongpassword
ADMIN_PASSWORD=strongpassword
DB_HOST=db
DB_PORT=3306

# Sites
NYERI_SITE_NAME=nyeri.site
TAITA_SITE_NAME=taita.site
MURANGA_SITE_NAME=muranga.site
VIHIGA_SITE_NAME=vihiga.site
HOMABAY_SITE_NAME=homabay.site
NANDI_SITE_NAME=nandi.site
MAKUENI_SITE_NAME=makueni.site

# Public/API Ports
NYERI_BACKEND_PORT=8001
TAITA_BACKEND_PORT=8002
MURANGA_BACKEND_PORT=8003
VIHIGA_BACKEND_PORT=8004
HOMABAY_BACKEND_PORT=8005
NANDI_BACKEND_PORT=8006
MAKUENI_BACKEND_PORT=8007

NYERI_FRONTEND_PORT=3000
TAITA_FRONTEND_PORT=3001
MURANGA_FRONTEND_PORT=3002
VIHIGA_FRONTEND_PORT=3003
HOMABAY_FRONTEND_PORT=3004
NANDI_FRONTEND_PORT=3005
MAKUENI_FRONTEND_PORT=3006

SITES="nyeri.site muranga.site"
ENGAGE_APPS="gis participatory_backend"
PMTS_APPS="project_monitor"

# Dockerhub repo
DOCKERHUB_USER=dockerhub-username
VERSION=latest

# External Site & Database Import Settings
IMPORT_EXTERNAL_SITE=true
# Set IMPORT_EXTERNAL_DB to true only if the db container name is different. Most cases it will all be the same i.e mariadb:10.6
IMPORT_EXTERNAL_DB=true
EXTERNAL_VOLUME_NAME=frappe-engage-pmts-deployment_sites-data
# EXTERNAL_SITES_DIR="/var/lib/docker/volumes/frappe-engage-pmts-deployment_sites-data/_data"
EXTERNAL_DB_CONTAINER="db"
EXTERNAL_DB_ROOT_PASSWORD="admin"

# Docker compose project name
ENGAGE_PROJECT_NAME=engage-participatory-tool
PIMTS_PROJECT_NAME=engage-pimts