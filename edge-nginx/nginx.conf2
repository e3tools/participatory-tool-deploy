worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout 65;

    map $http_origin $cors_origin {
        default "";
        "~^http://localhost:(3000|3001|8081|8082)$" "$http_origin";
    }

    # Headers required for Frappe Session & Cookie Persistence
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Frappe-Site-Name $http_x_frappe_site_name;

    # Upstream Definitions
    upstream frappe_backend {
        server frappe:8000;
    }
    upstream nyeri_frontend {
        server nyeri-react:80;
    }
    upstream muranga_frontend {
        server muranga-react:80;
    }

    # ---------------------------------------------------
    # 1. Nyeri React Frontend (Port 3000)
    # ---------------------------------------------------
    server {
        listen 3000;
        server_name _;

        location / {
            proxy_pass http://nyeri_frontend;
        }
    }

    # ---------------------------------------------------
    # 2. Muranga React Frontend (Port 3001)
    # ---------------------------------------------------
    server {
        listen 3001;
        server_name _;

        location / {
            proxy_pass http://muranga_frontend;
        }
    }

    # ---------------------------------------------------
    # 3. Nyeri Backend Direct Access (Port 8081)
    # ---------------------------------------------------

    # Public Nyeri Portal (Port 8081)
