    #         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     }
    # }

    server {
        listen 8081;
        server_name _;

        # # 1. Direct ALL Frappe JS, CSS, and static assets to frappe_backend
        # location /assets/ {
        #     proxy_pass http://frappe_backend/assets/;
        #     proxy_set_header Host "nyeri.site";
        #     proxy_set_header X-Frappe-Site-Name "nyeri.site";
        # }

        # 1. API Methods & Frappe Authentication
        location /api/ {
            proxy_pass http://frappe_backend;
            proxy_set_header Host "nyeri.site";
            proxy_set_header X-Frappe-Site-Name "nyeri.site";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;
        }

        location /app/ {
            proxy_pass http://frappe_backend;
            proxy_set_header Host "nyeri.site";
            proxy_set_header X-Frappe-Site-Name "nyeri.site";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;
        }

        # 2. Frappe Backend Core Assets ONLY
        location /app/assets/(frappe|gis|project_monitor|participatory_backend)/ {
            proxy_pass http://frappe_backend;

            proxy_set_header Host "nyeri.site";
            # proxy_set_header X-Frappe-Site-Name "nyeri.site";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Cookie $http_cookie;

            # Ensure cookies can be passed back and forth smoothly
            proxy_cookie_flags regular SameSite=Lax; 
        }

        # location ~ ^/(api|app|files|private|backups) {
        #     proxy_pass http://frappe_backend;
        #     proxy_set_header Host "nyeri.site";
        #     proxy_set_header X-Frappe-Site-Name "nyeri.site";
