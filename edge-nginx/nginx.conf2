        #     proxy_set_header X-Forwarded-Proto $scheme;
        #     proxy_set_header Cookie $http_cookie;
        # }

        # # 2. Forward API & Auth requests to Frappe Backend
        # location ~ ^/(api|app|files|private|backups)/ {
        #     proxy_pass http://frappe_backend;

        #     proxy_set_header Host "nyeri.site";
        #     # proxy_set_header X-Frappe-Site-Name "nyeri.site";
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        #     proxy_set_header Cookie $http_cookie;

        #     # Ensure cookies can be passed back and forth smoothly
        #     proxy_cookie_flags regular SameSite=Lax; 
        # }

        # # 2. Frappe Backend Core Assets ONLY
        # location /assets/(frappe|gis|project_monitor|participatory_backend)/ {
        #     proxy_pass http://frappe_backend;

        #     proxy_set_header Host "nyeri.site";
        #     # proxy_set_header X-Frappe-Site-Name "nyeri.site";
        #     proxy_set_header X-Real-IP $remote_addr;
        #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        #     proxy_set_header X-Forwarded-Proto $scheme;
        #     proxy_set_header Cookie $http_cookie;

        #     # Ensure cookies can be passed back and forth smoothly
        #     proxy_cookie_flags regular SameSite=Lax; 
        # }

        # 3. Socket.io for Real-time
        location /socket.io {
            proxy_pass http://frappe_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host "nyeri.site";
        }

        # 1. Forward React App requests to nyeri-react container
        # 4. React Frontend App & React Build Assets (Fallback)
        location / {
            proxy_pass http://nyeri_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
    
